<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pcrespoS3.Views.vlogin"
             Title="vlogin">

    <ContentPage.Resources>
        <Style x:Key="styleLaber" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="Aqua"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="BackgroundColor" Value="AliceBlue"/>
        </Style>
        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="Background" Value="Aqua"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="DarkKhaki"/>

        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout
        Padding="20"
        Spacing="15"
        BackgroundColor="Grey">
        <Label 
            Text="Inicio de sesion"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <Image Source="https://cdn-icons-png.flaticon.com/512/295/295128.png"
               WidthRequest="150"/>
        <Grid
            RowSpacing="10"
            ColumnSpacing="10"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Text="USUARIO: "
                   Style="{StaticResource styleLaber}"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Entry x:Name="txtUsuario" 
                   Placeholder="Igresa el usuario"
                   Style="{StaticResource styleEntry}"
                   Grid.Row="0"
                   Grid.Column="1"/>
            <Label Text="Contra: "
                   Style="{StaticResource styleLaber}"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Entry x:Name="txtContra" 
                   Placeholder="Igresa la contra"
                   Style="{StaticResource styleEntry}"
                   IsPassword="True"
                   Grid.Row="1"
                   Grid.Column="1"/>
            <Button x:Name="btnIniciarSesion"
                    Style="{StaticResource BotonGlobal}"
                    Text="Iniciar"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>
            <Button x:Name="btnRegistrarUsuario"
                    Text="Registrate"
                    Clicked="btnRegistrarUsuario_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>
            
        </Grid>


    </VerticalStackLayout>
</ContentPage>